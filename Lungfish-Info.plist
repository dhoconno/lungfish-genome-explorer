<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Shared source Info.plist for the Lungfish macOS app.

      This single file is the source of truth for the document-type and
      exported-UTI registrations consumed by BOTH build paths:
        * the notarized release build (Lungfish.xcodeproj sets
          INFOPLIST_FILE to this file with GENERATE_INFOPLIST_FILE = NO), and
        * the local debug bundle (scripts/build-app.sh copies this file and
          plutil-overrides the debug-specific identity fields).

      Fields written as $(BUILD_SETTING) are expanded by Xcode's "Process
      Info.plist" step during the xcodebuild path. scripts/build-app.sh
      replaces those same fields explicitly (it does not run that step), so the
      placeholders never reach a shipped bundle.
    -->

    <!-- Bundle Identification -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(LUNGFISH_BUNDLE_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>$(LUNGFISH_DISPLAY_NAME)</string>
    <key>LungfishReleaseChannel</key>
    <string>$(LUNGFISH_RELEASE_CHANNEL)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleHelpBookFolder</key>
    <string>Lungfish.help</string>
    <key>CFBundleHelpBookName</key>
    <string>Lungfish Help</string>

    <!-- Version Information (xcodebuild expands these from build settings;
         build-app.sh replaces them with the concrete debug values) -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- macOS Requirements -->
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>

    <!-- Icon (the release script re-affirms these via PlistBuddy after archive;
         build-app.sh copies the same AppIcon.icns) -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>

    <!-- Sparkle keys are absent here. The release builder injects them only
         into Preview/Stable candidates; Debug structurally has no updater. -->

